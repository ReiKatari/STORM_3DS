<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
            android:key="pref_cat_renderer_3d"
            android:title="@string/pref_cat_renderer_3d"
            app:iconSpaceReserved="false">

        <Preference
                android:key="video_quick_profile"
                android:title="@string/v794_video_quick_profile_title"
                android:summary="@string/v794_video_quick_profile_summary"
                app:iconSpaceReserved="false" />

        <com.storm3ds.emulator.ui.settings.preferences.InGameLockedListPreference
                android:key="video_renderer"
                android:title="@string/renderer"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/video_renderer_options"
                android:entryValues="@array/video_renderer_values"
                android:defaultValue="vulkan"/>

        <com.storm3ds.emulator.ui.settings.preferences.InGameLockedListPreference
                android:key="video_internal_resolution"
                android:title="@string/internal_resolution"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/video_internal_resolution_options"
                android:entryValues="@array/video_internal_resolution_values"
                android:defaultValue="2"/>

        <SwitchPreference
                android:key="video_async_shader_compilation"
                android:title="@string/pref_3ds_async_shader_title"
                android:summary="@string/pref_3ds_async_shader_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="true" />

        <ListPreference
                android:key="video_texture_filter"
                android:title="@string/pref_3ds_texture_filter_title"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/texture_filter_options"
                android:entryValues="@array/texture_filter_values"
                android:defaultValue="0" />

        <SwitchPreference
                android:key="enable_threaded_rendering"
                app:isPreferenceVisible="false"
                android:title="@string/threaded_rendering"
                android:summary="@string/threaded_rendering_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="true" />

        <com.storm3ds.emulator.ui.settings.preferences.InGameLockedListPreference
                android:key="video_filtering"
                android:title="@string/filter"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/video_filtering_options"
                android:entryValues="@array/video_filtering_values"
                android:defaultValue="quilez"/>

        <SwitchPreference
                android:key="3ds_accurate_mul"
                android:title="@string/setup_3ds_accurate_mul"
                android:summary="@string/setup_3ds_accurate_mul_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="false" />

        <SwitchPreference
                android:key="3ds_skip_duplicate_frames"
                android:title="@string/pref_3ds_skip_duplicate_frames_title"
                android:summary="@string/pref_3ds_skip_duplicate_frames_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="false" />

        <SwitchPreference
                android:key="3ds_disable_right_eye"
                android:title="@string/setup_3ds_disable_right_eye"
                android:summary="@string/setup_3ds_disable_right_eye_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="false" />

        <SwitchPreference
                android:key="3ds_limit_frames_ahead_of_gpu"
                android:title="@string/pref_3ds_limit_frames_ahead_title"
                android:summary="@string/pref_3ds_limit_frames_ahead_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="false" />

        <SwitchPreference
                android:key="3ds_adreno_turbo"
                android:title="@string/pref_3ds_adreno_turbo_title"
                android:summary="@string/pref_3ds_adreno_turbo_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="false" />

        <SwitchPreference
                android:key="3ds_simulate_gpu_timings"
                android:title="@string/pref_3ds_simulate_gpu_timings_title"
                android:summary="@string/pref_3ds_simulate_gpu_timings_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="false" />

        <ListPreference
                android:key="3ds_delay_render_thread_us"
                android:title="@string/pref_3ds_delay_render_thread_title"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/delay_render_thread_us_options"
                android:entryValues="@array/delay_render_thread_us_values"
                android:defaultValue="0" />

        <ListPreference
                android:key="3ds_texture_sampling"
                android:title="@string/pref_3ds_texture_sampling_title"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/texture_sampling_options"
                android:entryValues="@array/texture_sampling_values"
                android:defaultValue="0" />

        <ListPreference
                android:key="3ds_antialiasing"
                android:title="@string/pref_3ds_antialiasing_title"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/antialiasing_3ds_options"
                android:entryValues="@array/antialiasing_3ds_values"
                android:defaultValue="0" />

        <SwitchPreference
                android:key="3ds_fmv_hack"
                android:title="@string/setup_3ds_fmv_hack"
                android:summary="@string/setup_3ds_fmv_hack_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="false" />

        <SwitchPreference
                android:key="3ds_skip_slow_draw"
                android:title="@string/setup_3ds_skip_slow_draw"
                android:summary="@string/setup_3ds_skip_slow_draw_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="false" />

        <SwitchPreference
                android:key="3ds_skip_tex_copy"
                android:title="@string/setup_3ds_skip_tex_copy"
                android:summary="@string/setup_3ds_skip_tex_copy_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="false" />

        <SwitchPreference
                android:key="3ds_spirv_opt"
                android:title="@string/setup_3ds_spirv_opt"
                android:summary="@string/setup_3ds_spirv_opt_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory
            android:key="pref_cat_depth_color"
            android:title="@string/v794_cat_video_depth_color"
            app:iconSpaceReserved="false">

        <ListPreference
                android:key="video_vulkan_3d_depth_mode"
                android:title="@string/video_vulkan_3d_depth_mode_title"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/video_vulkan_3d_depth_mode_options"
                android:entryValues="@array/video_vulkan_3d_depth_mode_values"
                android:defaultValue="off" />

        <ListPreference
                android:key="video_vulkan_3d_depth_strength"
                android:title="@string/video_vulkan_3d_depth_strength_title"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/video_vulkan_3d_depth_strength_options"
                android:entryValues="@array/video_vulkan_3d_depth_strength_values"
                android:defaultValue="50" />
    </PreferenceCategory>

    <PreferenceCategory
            android:title="@string/pref_cat_retroarch_shaders"
            app:iconSpaceReserved="false">

        <Preference
                android:key="video_retroarch_shader_source"
                android:title="@string/video_retroarch_shader_source_title"
                app:iconSpaceReserved="false"
                android:persistent="false" />

        <ListPreference
                android:key="video_retroarch_shader_preset"
                android:title="@string/video_retroarch_shader_preset_title"
                android:summary="@string/video_retroarch_shader_preset_summary"
                app:iconSpaceReserved="false" />

        <com.storm3ds.emulator.ui.settings.preferences.StoragePickerPreference
                android:key="video_retroarch_shader_root"
                android:title="@string/video_retroarch_shader_root_title"
                android:summary="@string/video_retroarch_shader_root_summary"
                app:iconSpaceReserved="false"
                app:type="directory"
                app:permissions="read"
                app:persistPermissions="true" />

        <PreferenceScreen
                android:key="video_retroarch_shader_settings"
                android:title="@string/video_retroarch_shader_settings_title"
                android:summary="@string/video_retroarch_shader_settings_summary"
                app:iconSpaceReserved="false"
                android:persistent="false"
                android:layout="@layout/watermelon_preference">

            <Preference
                    android:key="video_retroarch_shader_report"
                    android:title="@string/shader_compatibility_report_title"
                    android:summary="@string/shader_compatibility_report_summary"
                    app:iconSpaceReserved="false"
                    android:persistent="false" />

            <Preference
                    android:key="video_retroarch_shader_manage"
                    android:title="@string/video_retroarch_shader_install_title"
                    android:summary="@string/video_retroarch_shader_install_summary"
                    app:iconSpaceReserved="false"
                    android:persistent="false" />

            <EditTextPreference
                    android:key="video_retroarch_shader_parameters"
                    android:title="@string/video_retroarch_shader_parameters_title"
                    android:summary="@string/video_retroarch_shader_parameters_summary"
                    app:iconSpaceReserved="false" />

            <SwitchPreference
                    android:key="video_retroarch_shader_clear_history"
                    android:title="@string/video_retroarch_shader_clear_history_title"
                    android:summary="@string/video_retroarch_shader_clear_history_summary"
                    app:iconSpaceReserved="false"
                    android:defaultValue="false" />

        </PreferenceScreen>
    </PreferenceCategory>

    <PreferenceCategory
            android:title="@string/pref_cat_enhancements"
            app:iconSpaceReserved="false">

        <SwitchPreference
                android:key="video_hd_textures_enabled"
                android:title="@string/video_hd_textures_title"
                android:summary="@string/video_hd_textures_summary"
                app:iconSpaceReserved="false"
                app:isPreferenceVisible="true"
                android:defaultValue="false" />

        <SwitchPreference
                android:key="video_dump_textures_enabled"
                android:title="@string/pref_3ds_dump_textures_title"
                android:summary="@string/pref_3ds_dump_textures_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="false" />

        <SwitchPreference
                android:key="video_preload_textures_enabled"
                android:title="@string/pref_3ds_preload_textures_title"
                android:summary="@string/pref_3ds_preload_textures_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="false" />

        <SwitchPreference
                android:key="video_oled_battery_saver"
                android:title="@string/video_oled_battery_saver_title"
                android:summary="@string/video_oled_battery_saver_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="false" />

        <SwitchPreference
                android:key="video_low_battery_saver"
                android:title="@string/video_low_battery_saver_title"
                android:summary="@string/video_low_battery_saver_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory
            android:title="@string/pref_cat_display_layout"
            app:iconSpaceReserved="false">

        <SwitchPreference
                android:key="video_console_skin_enabled"
                android:title="@string/video_console_skin_title"
                android:summary="@string/video_console_skin_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="false" />

        <ListPreference
                android:key="video_console_skin_type"
                android:title="@string/video_console_skin_type_title"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/console_skin_entries_v792"
                android:entryValues="@array/console_skin_values_v792"
                android:defaultValue="aurora_auto_theme"
                android:dependency="video_console_skin_enabled" />

        <SeekBarPreference
                android:key="video_console_skin_brightness"
                android:title="@string/video_console_skin_brightness_title"
                android:dependency="video_console_skin_enabled"
                app:iconSpaceReserved="false"
                android:defaultValue="100"
                app:min="30"
                android:max="100"
                app:showSeekBarValue="true" />

        <ListPreference
                android:key="fps_counter_position"
                android:title="@string/fps_counter_position"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/fps_counter_position_options"
                android:entryValues="@array/fps_counter_position_values"
                android:defaultValue="hidden" />

        <ListPreference
                android:key="resolution_hud_position"
                android:title="@string/resolution_hud_position_title"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/fps_counter_position_options"
                android:entryValues="@array/fps_counter_position_values"
                android:defaultValue="hidden" />

        <SwitchPreference
                android:key="hud_show_frame_time"
                android:title="@string/pref_hud_show_frame_time_title"
                android:summary="@string/pref_hud_show_frame_time_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="true" />

        <SwitchPreference
                android:key="hud_show_speed"
                android:title="@string/pref_hud_show_speed_title"
                android:summary="@string/pref_hud_show_speed_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="true" />

        <SwitchPreference
                android:key="hud_show_battery_temp"
                android:title="@string/pref_hud_show_battery_temp_title"
                android:summary="@string/pref_hud_show_battery_temp_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="false" />

        <SwitchPreference
                android:key="hud_show_app_ram"
                android:title="@string/pref_hud_show_app_ram_title"
                android:summary="@string/pref_hud_show_app_ram_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="false" />

        <SwitchPreference
                android:key="hud_show_available_ram"
                android:title="@string/pref_hud_show_available_ram_title"
                android:summary="@string/pref_hud_show_available_ram_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="false" />

        <SwitchPreference
                android:key="hud_show_background"
                android:title="@string/pref_hud_show_background_title"
                android:summary="@string/pref_hud_show_background_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="true" />

        <MultiSelectListPreference
                android:key="3ds_layouts_to_cycle"
                android:title="@string/pref_3ds_layouts_to_cycle_title"
                android:summary="@string/pref_3ds_layouts_to_cycle_summary"
                app:iconSpaceReserved="false"
                android:entries="@array/layouts_to_cycle_options"
                android:entryValues="@array/layouts_to_cycle_values"
                android:defaultValue="@array/layouts_to_cycle_defaults" />

        <SwitchPreference
                android:key="video_dual_screen_cast_enabled"
                android:title="@string/video_dual_screen_cast_title"
                android:summary="@string/video_dual_screen_cast_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="false" />

        <Preference
                android:key="dual_screen_presets"
                android:title="@string/dual_screen_presets_settings_title"
                app:iconSpaceReserved="false" />

        <ListPreference
                android:key="external_display_mode"
                android:title="@string/external_display_mode"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/external_display_mode_options"
                android:entryValues="@array/external_display_mode_values"
                android:defaultValue="melon_dual_ds" />

        <ListPreference
                android:key="dsi_camera_source"
                android:title="@string/dsi_camera_source"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/dsi_camera_source_options"
                android:entryValues="@array/dsi_camera_source_values"
                android:defaultValue="physical_cameras" />

        <com.storm3ds.emulator.ui.settings.preferences.StoragePickerPreference
                android:key="dsi_camera_static_image"
                android:title="@string/dsi_camera_image"
                app:iconSpaceReserved="false"
                app:type="file"
                app:permissions="read"
                app:persistPermissions="true"
                app:mimeType="image/jpeg|image/png" />
    </PreferenceCategory>

    <PreferenceCategory
            android:key="video_vulkan_driver_category"
            android:title="@string/video_vulkan_driver_category"
            app:iconSpaceReserved="false">

        <Preference
                android:key="video_vulkan_driver_manager"
                android:title="@string/video_vulkan_driver_manager_title"
                android:summary="@string/video_vulkan_driver_manager_summary"
                app:iconSpaceReserved="false" />

        <ListPreference
                android:key="video_vulkan_driver_mode"
                android:title="@string/video_vulkan_driver_mode"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/video_vulkan_driver_mode_options"
                android:entryValues="@array/video_vulkan_driver_mode_values"
                android:defaultValue="system" />

        <Preference
                android:key="video_vulkan_driver_import"
                android:title="@string/video_vulkan_driver_import"
                android:summary="@string/video_vulkan_driver_import_summary"
                app:iconSpaceReserved="false" />

        <PreferenceScreen
                android:key="video_freedreno_settings"
                android:layout="@layout/watermelon_preference"
                android:title="@string/freedreno_settings"
                android:summary="@string/freedreno_summary"
                android:persistent="false"
                app:iconSpaceReserved="false">

            <EditTextPreference
                    android:key="video_freedreno_fd_dev_features"
                    android:title="@string/freedreno_name_fd_dev_features"
                    android:defaultValue=""
                    app:iconSpaceReserved="false" />

            <EditTextPreference
                    android:key="video_freedreno_tu_debug"
                    android:title="@string/freedreno_name_tu_debug"
                    android:defaultValue=""
                    app:iconSpaceReserved="false" />

            <EditTextPreference
                    android:key="video_freedreno_fd_mesa_debug"
                    android:title="@string/freedreno_name_fd_mesa_debug"
                    android:defaultValue=""
                    app:iconSpaceReserved="false" />
        </PreferenceScreen>

        <Preference
                android:key="video_vulkan_driver_remove"
                android:title="@string/video_vulkan_driver_remove"
                android:summary="@string/video_vulkan_driver_remove_summary"
                app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
            android:title="@string/v780_video_maintenance_category"
            app:iconSpaceReserved="false">

        <Preference
                android:key="video_reset_enhancements"
                android:title="@string/v780_video_reset_enhancements_title"
                android:summary="@string/v780_video_reset_enhancements_summary"
                app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
