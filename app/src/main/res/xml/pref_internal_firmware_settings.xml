<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditTextPreference
            android:key="firmware_settings_nickname"
            android:title="@string/pref_3ds_profile_nickname"
            app:iconSpaceReserved="false"
            android:defaultValue="STORM 3DS" />

    <com.storm3ds.emulator.ui.settings.preferences.FirmwareBirthdayPreference
            android:key="firmware_settings_birthday"
            android:title="@string/firmware_birthday"
            app:iconSpaceReserved="false"
            android:defaultValue="01/01" />

    <SeekBarPreference
            android:key="3ds_play_coins"
            android:title="@string/pref_3ds_play_coins_title"
            android:summary="@string/pref_3ds_play_coins_summary"
            app:iconSpaceReserved="false"
            app:showSeekBarValue="true"
            android:defaultValue="300"
            app:min="0"
            android:max="300" />

    <Preference
            android:key="internal_mac_address"
            android:title="@string/mac_address"
            app:iconSpaceReserved="false" />

    <Preference
            android:key="internal_randomize_mac"
            android:title="@string/v780_internal_randomize_mac_title"
            android:summary="@string/v780_internal_randomize_mac_summary"
            app:iconSpaceReserved="false" />

    <Preference
            android:key="3ds_regenerate_console_id"
            android:title="@string/pref_3ds_regenerate_console_id_title"
            android:summary="@string/pref_3ds_regenerate_console_id_summary"
            app:iconSpaceReserved="false" />
</PreferenceScreen>
