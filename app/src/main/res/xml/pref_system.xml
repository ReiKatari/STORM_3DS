<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
            android:title="@string/pref_3ds_hardware_cat"
            app:iconSpaceReserved="false">

        <Preference
                android:key="system_3ds_setup"
                android:title="@string/pref_3ds_setup_title"
                android:summary="@string/pref_3ds_setup_summary"
                app:iconSpaceReserved="false" />

        <SwitchPreference
                android:key="3ds_is_new_3ds"
                android:title="@string/pref_3ds_new3ds_title"
                android:summary="@string/pref_3ds_new3ds_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="true" />

        <ListPreference
                android:key="3ds_cpu_clock_percentage"
                android:title="@string/pref_3ds_cpu_clock_title"
                app:useSimpleSummaryProvider="true"
                app:iconSpaceReserved="false"
                android:entries="@array/cpu_clock_percentage_options"
                android:entryValues="@array/cpu_clock_percentage_values"
                android:defaultValue="100" />

        <ListPreference
                android:key="3ds_region_value"
                android:title="@string/pref_3ds_region_title"
                app:useSimpleSummaryProvider="true"
                app:iconSpaceReserved="false"
                android:entries="@array/region_value_options"
                android:entryValues="@array/region_value_values"
                android:defaultValue="-1" />

        <ListPreference
                android:key="3ds_system_language"
                android:title="@string/pref_3ds_language_title"
                app:useSimpleSummaryProvider="true"
                app:iconSpaceReserved="false"
                android:entries="@array/system_language_options"
                android:entryValues="@array/system_language_values"
                android:defaultValue="-1" />

        <SwitchPreference
                android:key="3ds_apply_region_free"
                android:title="@string/pref_3ds_region_free_title"
                android:summary="@string/pref_3ds_region_free_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory
            android:title="@string/pref_cat_core_compiler"
            app:iconSpaceReserved="false">

        <SwitchPreference
                android:key="enable_storm_compiler"
                android:title="@string/enable_storm_compiler"
                android:summary="@string/enable_storm_compiler_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="true" />

        <ListPreference
                android:key="arm9_overclock"
                android:title="@string/arm9_overclock_title"
                app:isPreferenceVisible="false"
                app:iconSpaceReserved="false"
                android:entries="@array/arm9_overclock_options"
                android:entryValues="@array/arm9_overclock_values"
                android:defaultValue="1" />
    </PreferenceCategory>

    <PreferenceCategory
            android:title="@string/pref_cat_system_misc"
            app:iconSpaceReserved="false">

        <ListPreference
                android:key="app_language"
                android:title="@string/app_language"
                android:summary="@string/app_language_summary"
                android:entries="@array/app_language_options"
                android:entryValues="@array/app_language_values"
                android:defaultValue="default"
                app:useSimpleSummaryProvider="true"
                app:iconSpaceReserved="false" />

        <SwitchPreference
                android:key="system_app_log_file_enabled"
                android:title="@string/system_app_log_file_enabled"
                android:summary="@string/system_app_log_file_enabled_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="false" />

        <Preference
                android:key="system_share_app_log"
                android:title="@string/system_share_log_title"
                android:summary="@string/system_share_log_summary"
                app:iconSpaceReserved="false" />

        <SwitchPreference
                android:key="save_internal_config_as_file"
                android:title="@string/save_internal_config_as_file"
                android:summary="@string/save_internal_config_as_file_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory
            android:title="@string/pref_cat_bios_firmware"
            app:isPreferenceVisible="false"
            app:iconSpaceReserved="false">

        <Preference
                android:key="internal_firmware_settings"
                android:title="@string/internal_firmware_settings"
                app:isPreferenceVisible="false"
                app:iconSpaceReserved="false"
                android:fragment="com.storm3ds.emulator.ui.settings.fragments.FirmwarePreferencesFragment" />

        <Preference
                android:key="custom_bios_firmware"
                android:title="@string/custom_bios_firmware"
                app:isPreferenceVisible="false"
                app:iconSpaceReserved="false"
                android:fragment="com.storm3ds.emulator.ui.settings.fragments.CustomFirmwarePreferencesFragment" />
    </PreferenceCategory>

    <PreferenceCategory
            android:title="@string/pref_cat_network_wfc"
            app:isPreferenceVisible="false"
            app:iconSpaceReserved="false">

        <ListPreference
                android:key="system_wfc_server"
                android:title="@string/wfc_server_title"
                app:isPreferenceVisible="false"
                app:iconSpaceReserved="false"
                android:defaultValue="none"
                android:entries="@array/wfc_server_options"
                android:entryValues="@array/wfc_server_values" />

        <EditTextPreference
                android:key="system_wfc_custom_dns"
                android:title="@string/wfc_custom_dns_title"
                app:isPreferenceVisible="false"
                app:iconSpaceReserved="false"
                android:defaultValue="178.62.43.212" />

        <Preference
                android:key="system_wfc_test_connection"
                android:title="@string/wfc_test_connection_title"
                app:isPreferenceVisible="false"
                app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory
            android:title="@string/pref_cat_layout_management"
            app:iconSpaceReserved="false">

        <SwitchPreference
                android:key="system_disable_touch_gestures_on_touch_screen_area"
                android:title="@string/system_disable_touch_gestures_on_touch_screen_area"
                android:summary="@string/system_disable_touch_gestures_on_touch_screen_area_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="false" />

        <SwitchPreference
                android:key="system_ignore_display_cutout_in_layouts"
                android:title="@string/system_ignore_display_cutout_in_layouts"
                android:summary="@string/system_ignore_display_cutout_in_layouts_summary"
                app:iconSpaceReserved="false"
                android:defaultValue="false" />

        <Preference
                android:key="backup_internal_layout"
                android:title="@string/backup_internal_layout"
                app:isPreferenceVisible="@bool/settings_backup_restore_enabled"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="backup_external_layout"
                android:title="@string/backup_external_layout"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="restore_internal_layout"
                android:title="@string/restore_internal_layout"
                app:isPreferenceVisible="@bool/settings_backup_restore_enabled"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="restore_external_layout"
                android:title="@string/restore_external_layout"
                app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
