// Icon and Windows metadata for STORM 3DS
#include <winres.h>

IDI_ICON1 ICON DISCARDABLE "../../dist/storm3ds.ico"

#ifndef CREATEPROCESS_MANIFEST_RESOURCE_ID
#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1
#endif
#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "../../dist/azahar.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,12,1,0
 PRODUCTVERSION 1,12,1,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "STORM TEAM"
            VALUE "FileDescription", "STORM 3DS - Nintendo 3DS Emulator"
            VALUE "FileVersion", "1.12.1"
            VALUE "InternalName", "STORM_3DS"
            VALUE "LegalCopyright", "Copyright STORM TEAM (Citra / Azahar core, GPLv2/GPLv3)"
            VALUE "OriginalFilename", "STORM_3DS.exe"
            VALUE "ProductName", "STORM 3DS"
            VALUE "ProductVersion", "1.12.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
